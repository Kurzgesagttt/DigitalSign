# Copie este arquivo para .env no desenvolvimento e substitua os dois segredos obrigatórios.
# Gere cada valor separadamente; exemplo com Node.js 20+:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Não versione .env nem use valores de exemplo em produção.
POSTGRES_PASSWORD=
JWT_SECRET=

# Origem local; em Coolify substitua pelas URLs HTTPS públicas (exemplos abaixo).
APP_BASE_URL=http://localhost:8090
CORS_ALLOWED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Opcional: e-mail de uma conta já cadastrada a promover para ADMIN no início do backend.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid

# Exemplo de produção no Coolify:
# APP_BASE_URL=https://digitalsign.lucasmoreno.com.br
# CORS_ALLOWED_ORIGINS=https://digitalsign.lucasmoreno.com.br
# Cadastre POSTGRES_PASSWORD e JWT_SECRET como secrets; gere segredos novos e distintos.
