                                                      "header":  [
                                                                     {
                                                                         "key":  "Content-Type",
                                                                         "value":  "application/json"
                                                                     }
                                                                 ],
                                                      "body":  {
                                                                   "mode":  "raw",
                                                                   "raw":  "{\n  \"motivo\": \"Revogacao demonstrativa PIC\"\n}",
                                                                   "options":  {
                                                                                   "raw":  {
                                                                                               "language":  "json"
                                                                                           }
                                                                               }
                                                               },
                                                      "url":  "{{apiBaseUrl}}/v1/admin/signatures/{{signatureId}}/revoke"
                                                  }
                                  },
                                  {
                                      "name":  "Metricas",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [

